    "/api/validate": {
      "post": {
        "summary": "Validate Output",
        "description": "Return validated pasted or uploaded output from request.",
        "operationId": "validate_output_api_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "texts": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array",
                    "title": "Texts",
                    "example": [
                      "Hello world",
                      "Goodbye"
                    ]
                  },
                  "target_language": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "title": "Target Language",
                    "example": "vi"
                  },
                  "context": {
                    "type": "string",
                    "title": "Context",
                    "default": "",
                    "example": "Product interface"
                  },
                  "custom_prompt": {
                    "type": "string",
                    "title": "Custom Prompt",
                    "default": "",
                    "example": "Use a friendly tone."
                  },
                  "raw_output": {
                    "type": "string",
                    "title": "Raw Output",
                    "example": "{\"texts\":[\"Xin chào thế giới\"]}"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "texts",
                  "target_language",
                  "raw_output"
                ],
                "title": "ValidateRequest",
                "description": "Original input and pasted model output."
              }
            },
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "input": {
                    "type": "string",
                    "description": "JSON-encoded TranslationInput.",
                    "example": "{\"texts\":[\"hello\"],\"target_language\":\"vi\"}"
                  },
                  "output_file": {
                    "type": "string",
                    "format": "binary",
                    "description": "UTF-8 JSON object with texts array."
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "input",
                  "output_file"
                ]
              },
              "encoding": {
                "output_file": {
                  "contentType": "application/json"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslationResult"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
