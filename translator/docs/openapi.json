  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Sanitized API diagnostic without request content."
      },
      "FallbackResult": {
        "properties": {
          "source_index": {
            "type": "integer",
            "title": "Source Index"
          },
          "input": {
            "type": "string",
            "title": "Input"
          },
          "output": {
            "type": "string",
            "title": "Output"
          },
          "diagnostics": {
            "type": "string",
            "title": "Diagnostics"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_index",
          "input",
          "output",
          "diagnostics"
        ],
        "title": "FallbackResult",
        "description": "Source unit retained after translation fallback."
      },
      "ModelCatalog": {
        "properties": {
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelInfo"
            },
            "type": "array",
            "title": "Models"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "models"
        ],
        "title": "ModelCatalog",
        "description": "Models available to current request."
      },
      "ModelInfo": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "efforts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Efforts"
          },
          "session": {
            "type": "boolean",
            "title": "Session",
            "default": false
          },
          "context_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id"
        ],
        "title": "ModelInfo",
        "description": "Discovered model and known execution limits."
      },
      "PromptResponse": {
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "PromptResponse",
        "description": "Prompt ready to paste into ChatGPT."
      },
      "TranslationResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "partial"
            ],
            "title": "Status"
          },
          "texts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Texts"
          },
          "fallbacks": {
            "items": {
              "$ref": "#/components/schemas/FallbackResult"
            },
            "type": "array",
            "title": "Fallbacks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "texts",
          "fallbacks"
        ],
        "title": "TranslationResult",
        "description": "Validated texts in original document order."
      }
    }
  }
}
