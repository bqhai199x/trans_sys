    "/api/gemini/translations": {
      "post": {
        "summary": "Translate",
        "description": "Return direct translation of body using request credential.",
        "operationId": "translate_api_gemini_translations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "api_key": {
                    "type": "string",
                    "minLength": 1,
                    "format": "password",
                    "title": "Api Key",
                    "writeOnly": true,
                    "example": "YOUR_GEMINI_API_KEY"
                  },
                  "texts": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array",
                    "title": "Texts",
                    "example": [
                      "Hello world",
                      "Goodbye"
                    ]
                  },
                  "target_language": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "title": "Target Language",
                    "example": "vi"
                  },
                  "context": {
                    "type": "string",
                    "title": "Context",
                    "default": "",
                    "example": "Product interface"
                  },
                  "custom_prompt": {
                    "type": "string",
                    "title": "Custom Prompt",
                    "default": "",
                    "example": "Use a friendly tone."
                  },
                  "model": {
                    "type": "string",
                    "maxLength": 200,
                    "minLength": 1,
                    "title": "Model",
                    "example": "gemini-2.5-flash"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "batch",
                      "sync"
                    ],
                    "title": "Mode",
                    "default": "batch",
                    "example": "batch"
                  },
                  "reasoning_effort": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Reasoning Effort",
                    "example": ""
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "api_key",
                  "texts",
                  "target_language",
                  "model"
                ],
                "title": "GeminiRequest",
                "description": "Translation input with a request-owned Gemini key."
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslationResult"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "499": {
